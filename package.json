    "财税",
    "跨境电商",
    "出口退税",
    "合规",
    "ima"
  ],
  "license": "MIT",
  "homepage": "https://github.com/fleekelon/dsh-fintax#readme",
  "bugs": {
    "url": "https://github.com/fleekelon/dsh-fintax/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fleekelon/dsh-fintax.git"
  },
  "scripts": {
    "test": "node --test test/calc.test.js"
